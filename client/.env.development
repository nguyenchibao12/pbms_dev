# Dev: gọi API qua proxy Vite (cùng origin) — tránh CORS & lỗi mixed content khi chạy HTTPS
VITE_API_URL=/api

# Google Sign-In. Client ID là thông tin PUBLIC (nằm sẵn trong bundle gửi tới trình duyệt),
# phải KHỚP GOOGLE_CLIENT_ID trong server/.env. Khi build production cần đặt biến này
# trong .env / .env.production (Vite nướng env vào bundle lúc build, không phải lúc chạy).
VITE_GOOGLE_CLIENT_ID=121051264373-4kqi95tp6dqj568c9nc84158n2lv6re9.apps.googleusercontent.com
